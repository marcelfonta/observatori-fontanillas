{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "replace-with-existing-worker-name",
  "main": "../worker/index.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "ENVIRONMENT": "local",
    "META_VIDEO_AUTOMATION_ENABLED": "false",
    "META_VIDEO_AUTO_TIMES": "07:00,20:30",
    "BUFFER_TIKTOK_AUTOMATION_ENABLED": "false",
    "BUFFER_X_AUTOMATION_ENABLED": "false",
    "SOCIAL_AUTOMATION_ENABLED": "false",
    "SOCIAL_PERIODIC_ENABLED": "false",
    "SOCIAL_PERIODIC_TIME": "12:00",
    "SOCIAL_EVENT_POSTS_ENABLED": "false",
    "SOCIAL_ENVIRONMENTAL_ENABLED": "false",
    "SOCIAL_ENVIRONMENTAL_TIME": "12:00",
    "SOCIAL_DUST_THRESHOLD_UG_M3": "0",
    "SOCIAL_EPHEMERIDES_ENABLED": "false",
    "SOCIAL_EDUCATIONAL_TIME": "17:00",
    "METEOCAT_ALERT_SOCIAL_ENABLED": "false",
    "SOCIAL_AUTO_TIMES": "07:00,14:00,20:30",
    "SOCIAL_PREFLIGHT_TIME": "06:45,13:45,20:15",
    "BLUESKY_HANDLE": "meteofontanillas.bsky.social",
    "TELEGRAM_CHANNEL_ID": "@meteofontanillas",
    "CONTACT_FROM": "Observatori Fontanillas <formulari@fontanillas.cat>",
    "ONESIGNAL_APP_ID": "REPLACE_WITH_ONESIGNAL_APP_ID",
    "PUBLIC_WORKER_URL": "https://fonta-meteo.marcelfonta.workers.dev",
    "GITHUB_SHORTS_REPOSITORY": "marcelfonta/observatori-fontanillas"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REPLACE_WITH_STAGING_D1_NAME",
      "database_id": "REPLACE_WITH_STAGING_D1_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SOCIAL_VIDEO_BUCKET",
      "bucket_name": "meteo-fontanillas-social-video"
    }
  ],
  "env": {
    "staging": {
      "name": "replace-with-staging-worker-name",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "staging",
        "META_VIDEO_AUTOMATION_ENABLED": "false",
        "META_VIDEO_AUTO_TIMES": "07:00,20:30",
        "BUFFER_TIKTOK_AUTOMATION_ENABLED": "false",
        "BUFFER_X_AUTOMATION_ENABLED": "false",
        "SOCIAL_AUTOMATION_ENABLED": "false",
        "SOCIAL_PERIODIC_ENABLED": "false",
        "SOCIAL_EVENT_POSTS_ENABLED": "false",
        "SOCIAL_ENVIRONMENTAL_ENABLED": "false",
        "SOCIAL_EPHEMERIDES_ENABLED": "false",
        "METEOCAT_ALERT_SOCIAL_ENABLED": "false",
        "SOCIAL_PREFLIGHT_TIME": "06:45,13:45,20:15"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "REPLACE_WITH_STAGING_D1_NAME",
          "database_id": "REPLACE_WITH_STAGING_D1_ID"
        }
      ]
    }
  }
}
