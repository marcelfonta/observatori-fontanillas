{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "REPLACE_WITH_EXISTING_WORKER_NAME",
  "main": "../worker/index.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "ENVIRONMENT": "local",
    "SOCIAL_AUTOMATION_ENABLED": "false",
    "SOCIAL_PREFLIGHT_TIME": "07:45"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REPLACE_WITH_STAGING_D1_NAME",
      "database_id": "REPLACE_WITH_STAGING_D1_ID"
    }
  ],
  "env": {
    "staging": {
      "name": "REPLACE_WITH_STAGING_WORKER_NAME",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "staging",
        "SOCIAL_AUTOMATION_ENABLED": "false",
        "SOCIAL_PREFLIGHT_TIME": "07:45"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "REPLACE_WITH_STAGING_D1_NAME",
          "database_id": "REPLACE_WITH_STAGING_D1_ID"
        }
      ]
    }
  }
}
