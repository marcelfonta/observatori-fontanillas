{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "fonta-meteo-staging",
  "main": "../worker/index.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "staging",
    "SOCIAL_AUTOMATION_ENABLED": "false"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fonta-meteo-staging",
      "database_id": "5d6fc12d-9432-45bb-9c4e-7b2d6615fae8",
      "remote": true
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "browser": {
    "binding": "BROWSER"
  }
}
